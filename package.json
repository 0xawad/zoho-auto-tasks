{
  "name": "zoho-auto-tasks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenCode agent that turns informal daily work summaries into Zoho Desk tasks",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "cli": "node src/cli.ts",
    "setup": "node src/cli.ts setup",
    "discover": "node src/cli.ts discover",
    "install-agent": "node scripts/install.ts",
    "test:bun": "npx --yes bun scripts/runtime-check.ts",
    "test:runtime": "node scripts/runtime-check.ts"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.3.17",
    "dotenv": "^16.6.1",
    "zod": "4.1.8"
  }
}
