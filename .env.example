# Zoho Desk setup for zoho-auto-tasks. Never commit real values.
#
# This file is loaded from ${XDG_CONFIG_HOME:-~/.config}/zoho-auto-tasks/.env.
# Explicit environment variables take precedence, which supports CI and secret managers.

# Your Zoho data centre and local work timezone.
ZOHO_REGION=us
ZOHO_TIMEZONE=Etc/UTC

# Created tasks are assigned to this active Zoho Desk agent. Setup resolves this email to
# the numeric Zoho agent ID; it will never choose a similarly named user.
ZOHO_OWNER_EMAIL=you@example.com

# Select one target department. Use the numeric ID when known (it takes precedence), or a
# unique visible department name. Setup rejects a missing or ambiguous name.
# ZOHO_DEPARTMENT_ID=
ZOHO_DEPARTMENT_NAME=Support

# Optional when this Zoho token has access to exactly one organization. Required otherwise.
# ZOHO_ORG_ID=

# Self-client credentials from https://api-console.zoho.com.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Paste an existing refresh token here, if you have one. Otherwise leave this blank and run
# `node src/cli.ts connect` once after filling the client ID and secret. A subsequent
# `npm run setup` moves the generated token into this restricted .env file automatically.
ZOHO_REFRESH_TOKEN=

# Task defaults. Status names must exactly match your portal's task form.
ZOHO_DEFAULT_PRIORITY=Normal
ZOHO_STATUS_COMPLETED=Completed
ZOHO_STATUS_IN_PROGRESS=In Progress
# ZOHO_STATUS_PLANNED=Not Started
ZOHO_SUBMISSION_MODE=preview

# Work-date placement: none, dueDate, or customField. A custom field must be verified during
# setup before it will be written.
ZOHO_WORK_DATE_MODE=none
# ZOHO_WORK_DATE_FIELD=cf_work_date

# Optional work-session scheduling. Enable only when your portal has these custom fields.
ZOHO_WORK_SESSION_ENABLED=false
ZOHO_WORK_SESSION_START=09:00
ZOHO_WORK_SESSION_END=18:00
# ZOHO_WORK_SESSION_START_FIELD=cf_start_date_time
# ZOHO_WORK_SESSION_END_FIELD=cf_end_date_time
# ZOHO_WORK_SESSION_PERCENTAGE_FIELD=cf_percentage_of_completion
ZOHO_WORK_SESSION_PERCENTAGE=100
ZOHO_WORK_SESSION_DEFAULT_MINUTES=60
ZOHO_WORK_SESSION_MIN_MINUTES=15
ZOHO_WORK_SESSION_MAX_MINUTES=480
ZOHO_WORK_SESSION_GRANULARITY_MINUTES=5

# Conservative operational settings. Keep preview mode and the default retry values unless you
# have a specific reason to change them.
ZOHO_PATCH_IF_NOT_CLOSED=false
ZOHO_MAX_BATCH_SIZE=25
ZOHO_REQUEST_TIMEOUT_MS=20000
ZOHO_MAX_RETRIES=3
ZOHO_DUPLICATE_WINDOW_DAYS=7
ZOHO_RETENTION_DAYS=30

# Optional aliases as compact JSON, for example:
# ZOHO_ALIASES_JSON={"Acme":{"contactId":"123","ticketId":null,"label":"Acme"}}
